{
  "include": ["src/*.ts", "src/**/*.test.ts"],
  "compilerOptions": {
    "rootDir": "./src",
    "target": "es2020",
    "types": ["@types/node"],
    "moduleResolution": "Node10",
    // moduleResolution=node10 is deprecated in TypeScript 6.0.
    "ignoreDeprecations": "6.0",
    "strict": true,
    "forceConsistentCasingInFileNames": true
  }
}
